{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aluguel360-seed-imovel-v1",
  "title": "Imóvel completo para seed Aluguel360",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "status", "property", "listing", "rooms", "midias"],
  "properties": {
    "seed_id": {"type": "string", "pattern": "^imovel-[0-9]{3}-[a-z0-9-]+$"},
    "status": {"const": "completo"},
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "area_m2", "cep", "logradouro", "numero", "bairro", "cidade", "estado", "complemento", "referencia", "features"],
      "properties": {
        "tipo": {"enum": ["CASA", "APARTAMENTO", "KITNET", "COMODO", "OUTRO"]},
        "area_m2": {"type": "number", "exclusiveMinimum": 0},
        "cep": {"type": "string", "pattern": "^[0-9]{5}-?[0-9]{3}$"},
        "logradouro": {"type": "string", "minLength": 1},
        "numero": {"type": "string", "minLength": 1},
        "bairro": {"type": "string", "minLength": 1},
        "cidade": {"type": "string", "minLength": 1},
        "estado": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "complemento": {"type": "string", "minLength": 1},
        "referencia": {"type": "string", "minLength": 1},
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pets", "condominio", "suite", "mobiliado", "iptu", "portaria", "escolas", "transporte"],
          "properties": {
            "pets": {"type": "boolean"},
            "condominio": {"type": "boolean"},
            "suite": {"type": "boolean"},
            "mobiliado": {"type": "boolean"},
            "iptu": {"type": "boolean"},
            "portaria": {"type": "boolean"},
            "escolas": {"type": "boolean"},
            "transporte": {"type": "boolean"}
          }
        }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titulo", "descricao", "extra_info", "aluguel", "negociavel", "condominio_valor", "condominio_incluido", "iptu_valor", "iptu_incluido", "outras_taxas", "garantia"],
      "properties": {
        "titulo": {"type": "string", "minLength": 1},
        "descricao": {"type": "string", "minLength": 1},
        "extra_info": {"type": "string", "minLength": 1},
        "aluguel": {"type": "number", "exclusiveMinimum": 0},
        "negociavel": {"type": "boolean"},
        "condominio_valor": {"type": ["number", "null"], "minimum": 0},
        "condominio_incluido": {"type": "boolean"},
        "iptu_valor": {"type": ["number", "null"], "minimum": 0},
        "iptu_incluido": {"type": "boolean"},
        "outras_taxas": {"type": "string", "minLength": 1},
        "garantia": {"enum": ["CAUCAO", "FIADOR", "SEM_GARANTIA", "SEGURO_FIANCADO"]}
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "quantidade"],
        "properties": {
          "tipo": {"enum": ["quartos", "suites", "banheiros", "salas", "garagem", "varandas", "outros"]},
          "quantidade": {"type": "integer", "minimum": 0}
        }
      }
    },
    "midias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arquivo", "tipo", "ambiente", "ordem", "is_highlight"],
        "properties": {
          "arquivo": {"type": "string", "pattern": "^midias/.+"},
          "tipo": {"enum": ["FOTO", "VIDEO"]},
          "ambiente": {"type": "string", "minLength": 1},
          "ordem": {"type": "integer", "minimum": 1},
          "is_highlight": {"type": "boolean"}
        }
      }
    }
  }
}
